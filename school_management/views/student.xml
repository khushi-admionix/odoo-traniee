<odoo>
    <record id ='school_student_list' model="ir.ui.view">
        <field name = "name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list>
                <field name ="name"/>
                <field name ="std"/>
                <field name ="roll_no"/>
                <field name ="age"/>
                <field name="gender"/>
                <field name="address"/>
                <field name="fees"/>
                <field name="discount"/>
                <field name="final_fees"/>
            </list>
        </field>
    </record>

    <record id="school_student_view_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form>
            <sheet>
                <group>
                    <field name ="name"/>
                    <field name ="std"/>
                    <field name ="roll_no"/>
                    <field name ="age"/>
                    <field name="gender" widget="radio"/>
                    <field name="address"/>
                    <field name="fees"/>
                    <field name="discount"/>
                    <field name="final_fees"/>

                    <field name="subject_ids"
                           widget="many2many_tags"
                           options="{'color_field': 'color'}"/>

                    <field name="status"
                           widget="progressbar"
                           options="{'draft': 'grey','confirmed':'blue','done':'green'}"/>
                </group>
            </sheet>
            </form>
        </field>
    </record>

    <record id="school_subject_form" model="ir.ui.view">
    <field name="name">school.subject.form</field>
    <field name="model">school.subject</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="color"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

    <record id="school_subject_list" model="ir.ui.view">
    <field name="name">school.subject.list</field>
    <field name="model">school.subject</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="color"/>
        </list>
    </field>
</record>

    <record id="search_school_student" model="ir.ui.view">
        <field name = "name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search>
                <filter string="age" name="age1" domain="[('age','>',18)]"/>
            </search>
        </field>
    </record>

    <record id ="action_school_student" model="ir.actions.act_window">
        <field name="name">Podar</field>
        <field name="res_model">school.student</field>
        <field name="search_view_id" ref="search_school_student"/>
        <field name="view_mode">list,form</field>
        <field name="context">
            {
            'search_default_age1':1,
            }
        </field>
    </record>

    <record id="action_school_subject" model="ir.actions.act_window">
    <field name="name">Subjects</field>
    <field name="res_model">school.subject</field>
    <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_school_student_root" name="SchoolManagement"/>
    <menuitem id="menu_school_student"
              name="Students"
              parent="menu_school_student_root"
              action="action_school_student"/>
    <menuitem id="menu_school_subject"
          name="Subjects"
          parent="menu_school_student_root"
          action="action_school_subject"/>


</odoo>