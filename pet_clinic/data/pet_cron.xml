<odoo>
    <record id="ir_cron_check_missed_appointments" model="ir.cron">
        <field name="name">Check Missed Pet Appointments</field>
        <field name="model_id" ref="model_pet_appointment"/>
        <field name="state">code</field>
        <field name="code">model.check_missed_appointments()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="priority">4</field>
    </record>
</odoo>
