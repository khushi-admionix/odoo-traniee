<odoo>

    <record id="view_pet_visit_list" model="ir.ui.view">
        <field name="name">pet.visit.list</field>
        <field name="model">pet.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="pet_id"/>
                <field name="visit_date"/>
                <field name="create_date"/>
                <field name="doctor"/>
            </list>
        </field>
    </record>

    <record id="view_pet_visit_form" model="ir.ui.view">
        <field name="name">pet.visit.form</field>
        <field name="model">pet.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done"
                            type="object"
                            string="Mark Done"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="pet_id"/>
                        <field name="visit_date" widget="date"/>
                        <field name="symptoms"/>
                        <field name="treatment"/>
                        <field name="doctor"/>
                        <field name="priority" widget="radio"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

<!--- Visits Action -->
    <record id="action_pet_visit" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">pet.visit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pet_visit_root" name="Pet Clinic" sequence="10"/>
    <menuitem id="menu_pet_visit"
              name="Visits"
              parent="menu_pet_visit_root"
              action="action_pet_visit"
              sequence="3"/>
</odoo>


