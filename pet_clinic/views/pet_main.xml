<odoo>

    <record id="view_pet_list" model="ir.ui.view">
        <field name="name">pet.pet.list</field>
        <field name="model">pet.pet</field>
        <field name="arch" type="xml">
            <list>
                <field name="pet_name"/>
                <field name="pet_type"/>
                <field name="age"/>
                <field name="owner_id"/>
            </list>
        </field>
    </record>

    <record id="view_pet_form" model="ir.ui.view">
        <field name="name">pet.pet.form</field>
        <field name="model">pet.pet</field>
        <field name="arch" type="xml">
            <form string="pet">
                <header>
                    <button name="%(pet_clinic.action_visit_wizard)d"
                            type="action"
                            string="Create Visit"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">

                        <button name="action_view_visits"
                                string="Visits"
                                type="object"
                                icon="fa-medkit">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="visit_count"/>
                                </span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <field name="pet_name"/>
                        <field name="pet_type"/>
                        <field name="age"/>
                        <field name="owner_id"/>
                        <field name="vaccinated" widget="checkbox"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pet_pet" model="ir.actions.act_window">
        <field name="name">Pets</field>
        <field name="res_model">pet.pet</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="server_action_pet_senior" model="ir.actions.server">
         <field name="name">Mark Senior Pets</field>
        <field name="model_id" ref="model_pet_pet"/>
        <field name="binding_model_id" ref="model_pet_pet"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_mark_senior()
        </field>

    </record>

    <menuitem id="menu_pet_pet"
              name="Pets"
              parent="menu_pet_visit_root"
              action="action_pet_pet"
                sequence="2"/>

</odoo>