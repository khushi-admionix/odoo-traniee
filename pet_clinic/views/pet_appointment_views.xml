<odoo>

    <!-- LIST VIEW -->
    <record id="view_pet_appointment_list" model="ir.ui.view">
        <field name="name">pet.appointment.list</field>
        <field name="model">pet.appointment</field>
        <field name="arch" type="xml">
            <list>
                <field name="pet_name"/>
                <field name="appointment_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>


    <!-- FORM VIEW -->
    <record id="view_pet_appointment_form" model="ir.ui.view">
        <field name="name">pet.appointment.form</field>
        <field name="model">pet.appointment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="pet_name"/>
                        <field name="appointment_date"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ACTION -->
    <record id="action_pet_appointment" model="ir.actions.act_window">
        <field name="name">Pet Appointments</field>
        <field name="res_model">pet.appointment</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- MENU -->
    <menuitem id="menu_pet_root"
              name="Pet Clinic"
              sequence="4"/>

    <menuitem id="menu_pet_appointment"
              name="Appointments"
              parent="menu_pet_root"
              action="action_pet_appointment"/>

</odoo>