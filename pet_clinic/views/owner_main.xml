<odoo>

    <!-- Owner list View -->
    <record id="view_pet_owner_list" model="ir.ui.view">
        <field name="name">pet.owner.list</field>
        <field name="model">pet.owner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <!-- Owner Form View -->
    <record id="view_pet_owner_form" model="ir.ui.view">
        <field name="name">pet.owner.form</field>
        <field name="model">pet.owner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Owners Action -->
    <record id="action_pet_owner" model="ir.actions.act_window">
        <field name="name">Owners</field>
        <field name="res_model">pet.owner</field>
        <field name="view_mode">list,form</field>
    </record>



    <!-- Owners Menu -->
    <menuitem id="menu_pet_owner"
              name="Owners"
              parent="menu_pet_visit_root"
              action="action_pet_owner"
              sequence="1"/>

</odoo>