<odoo>

    <!-- Wizard Form View -->
    <record id="view_visit_wizard_form" model="ir.ui.view">
        <field name="name">visit.wizard.form</field>
        <field name="model">visit.wizard</field>
        <field name="arch" type="xml">

            <form string="Create Visit">

                <group>
                    <field name="pet_id"/>
                    <field name="symptoms"/>
                    <field name="treatment"/>
                </group>

                <footer>
                    <button name="create_visit"
                            type="object"
                            string="Create Visit"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>

        </field>
    </record>
        <record id="action_visit_wizard" model="ir.actions.act_window">
        <field name="name">Create Visit</field>
        <field name="res_model">visit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
</record>


</odoo>