<odoo>
           <!---Book form and list view-->
    <record id="view_library_book_list" model="ir.ui.view">
    <field name="name">library.book.list</field>
    <field name="model">library.book</field>
    <field name="arch" type="xml">
    <list>
        <field name="name"/>
        <field name="author"/>
        <field name="isbn"/>
        <field name="available_qty"/>
        <field name="state"/>
    </list>
    </field>
    </record>
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="isbn"/>
                        <field name="price"/>
                        <field name="available_qty"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!--    <-Search View-->

    <record id="view_library_book_search" model="ir.ui.view">
    <field name="name">library.book.search</field>
    <field name="model">library.book</field>
    <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>

                <filter name="available"
                       string="Available"
                       domain="[('state','=','available')]"/>
                <filter name="unavailable"
                       string="Unavailable"
                       domain="[('state','=','unavailable')]"/>
            </search>
    </field>
    </record>
                     <!-- Action and Menu -->
    <record id="action_library_books" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form,search</field>
        <field name="search_view_id" ref="view_library_book_search"/>
    </record>
    <menuitem id="menu_library_root" name="Library" sequence="10"/>
    <menuitem id="menu_library_books" parent="menu_library_root" action="action_library_books" name="Books" sequence="1"/>
</odoo>
